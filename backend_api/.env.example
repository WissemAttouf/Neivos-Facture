# Copy this file to .env and replace placeholders with local values.
# Never commit the real .env file.

PORT=8086

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ocr_scanner_db

# Required by backend_api/server.js
JWT_SECRET=replace_with_a_long_random_secret

# Optional email configuration used by the password-recovery flow
EMAIL_USER=
EMAIL_PASS=

# Base URL of the separately hosted OCR service.
# Set this to the URL supplied by the OCR service administrator.
OCR_API_URL=http://YOUR_OCR_HOST:8775
